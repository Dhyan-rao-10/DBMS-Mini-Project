# Copy to .env and fill in real values. .env is git-ignored.

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=royalty
POSTGRES_USER=royalty_admin
POSTGRES_PASSWORD=change_me

# --- MongoDB ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=royalty_raw
MONGO_ROOT_USER=royalty_admin
MONGO_ROOT_PASSWORD=change_me

# --- Neo4j (graph mirror of samples / collaborations) ---
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_min_8_chars

# --- Redis (sessions, rate limits, leaderboards) ---
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_URL=redis://:change_me@localhost:6379

# --- Seed data: password given to every demo login (admin, staff, contributors) ---
SEED_USER_PASSWORD=change_me

# --- Web app (used from Phase 5) ---
# The app logs in as royalty_app (no privileges of its own) and runs SET LOCAL ROLE per request
APP_DB_PASSWORD=change_me
DATABASE_URL=postgresql://royalty_app:change_me@localhost:5432/royalty
MONGODB_URI=mongodb://royalty_admin:change_me@localhost:27017/?authSource=admin
AUTH_SECRET=generate_with_openssl_rand_base64_32
